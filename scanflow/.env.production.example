# Copy to .env only on the deployment host. Never commit actual secrets.
POSTGRES_DB=scanflow
DB_USERNAME=scanflow
DB_PASSWORD=replace-with-a-unique-long-random-secret
DB_POOL_SIZE=10

# Use a cryptographically random secret of at least 32 bytes.
APP_JWT_SECRET=replace-with-at-least-32-random-bytes
APP_JWT_EXPIRY_MS=900000
APP_PUBLIC_URL=https://admin.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://business.example.com

PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_NAME=ScanFlow Platform Administrator
PLATFORM_ADMIN_PASSWORD=replace-with-a-unique-strong-password

API_PORT=8080
SCANFLOW_IMAGE_TAG=local
